---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BoldLatin from '@/components/BoldLatin.astro';
import { getCollection } from 'astro:content';
import { countWords } from '@/lib/wordCount.js';

const works = (await getCollection('works', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Works">
  <h1>Works</h1>
  <p style="color: var(--ink-dim);">
    一些小说和画合集<br />
    小説と絵画のコレクション
  </p>

  {
    works.length === 0 ? (
      <p style="color: var(--ink-dim); font-style: italic;">Nothing here yet.</p>
    ) : (
      <div class="card-grid">
        {
          works.map((w) => (
            <a class="card" href={`/works/${w.slug}/`}>
              {w.data.cover && (
                <div class="card__cover-wrap">
                  <img
                    src={w.data.cover}
                    alt={w.data.title}
                    class="card__cover"
                  />
                  {w.data.rating !== 'all-ages' && (
                    <span class={`rating rating--${w.data.rating} rating--overlay`}>
                      {w.data.rating}
                    </span>
                  )}
                </div>
              )}
              <h3 class="card__title"><BoldLatin text={w.data.title} /></h3>
              <div class="card__meta">
                {w.data.rating !== 'all-ages' && <>{w.data.rating} · </>}
                {w.data.status && <>{w.data.status} · </>}
                {countWords(w.body ?? '')} words
              </div>
              {w.data.summary && <p class="card__summary">{w.data.summary}</p>}
            </a>
          ))
        }
      </div>
    )
  }
</BaseLayout>

<style>
  .card__cover {
    width: 100%;
    height: auto;
    border-radius: 4px;
    margin-bottom: 0.8rem;
    display: block;
    background: var(--bg-elev-2);
  }
</style>

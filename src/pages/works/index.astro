---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const works = (await getCollection('works', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Works">
  <h1>Works</h1>
  <p style="color: var(--ink-dim);">
    Pictures, texts, and the spaces between them.
  </p>

  {
    works.length === 0 ? (
      <p style="color: var(--ink-dim); font-style: italic;">Nothing here yet.</p>
    ) : (
      <div class="card-grid">
        {
          works.map((w) => (
            <a class="card" href={`/works/${w.slug}/`}>
              {w.data.cover && (
                <img
                  src={w.data.cover}
                  alt={w.data.title}
                  class="card__cover"
                />
              )}
              <h3 class="card__title">{w.data.title}</h3>
              {w.data.summary && <p class="card__summary">{w.data.summary}</p>}
            </a>
          ))
        }
      </div>
    )
  }
</BaseLayout>

<style>
  .card__cover {
    width: 100%;
    height: auto;
    border-radius: 4px;
    margin-bottom: 0.8rem;
    display: block;
    background: var(--bg-elev-2);
  }
</style>

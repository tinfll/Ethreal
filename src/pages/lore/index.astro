---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const all = (await getCollection('lore', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const characters = (await getCollection('characters', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);

const sections = ['metaphysics', 'history', 'geography', 'cultures', 'institution', 'misc'] as const;
const grouped = sections.map((s) => ({
  section: s,
  entries: all.filter((e) => e.data.section === s),
})).filter((g) => g.entries.length > 0);
---

<BaseLayout title="Lore">
  <h1>Lore</h1>
  <p style="color: var(--ink-dim);">
    The world's substrate — its rules, its stories, its dirt.
  </p>

  {
    grouped.map((group) => (
      <section>
        <h2 style="text-transform: capitalize;">{group.section}</h2>
        <ul style="list-style: none; padding: 0;">
          {group.entries.map((e) => (
            <li style="margin: 0.4rem 0;">
              <a href={`/lore/${e.slug}/`}>{e.data.title}</a>
              {e.data.summary && (
                <span style="color: var(--ink-dim); margin-left: 0.6em;">— {e.data.summary}</span>
              )}
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {
    characters.length > 0 && (
      <section>
        <h2>characters</h2>
        <div class="card-grid">
          {characters.map((c) => (
            <a class="card" href={`/characters/${c.slug}/`}>
              <h3 class="card__title">{c.data.name}</h3>
              {c.data.title && <div class="card__meta">{c.data.title}</div>}
              <p class="card__summary">{c.data.summary}</p>
            </a>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const characters = (await getCollection('characters', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title="Characters">
  <h1>Characters</h1>
  <p style="color: var(--ink-dim);">{characters.length} entries in the archive.</p>

  <div class="card-grid">
    {
      characters.map((c) => (
        <a class="card" href={`/characters/${c.slug}/`}>
          <h3 class="card__title">{c.data.name}</h3>
          {c.data.title && <div class="card__meta">{c.data.title}</div>}
          <p class="card__summary">{c.data.summary}</p>
          <div style="margin-top: 0.6rem;">
            {c.data.tags.map((t) => <span class="tag">{t}</span>)}
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
